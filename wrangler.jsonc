{
  // dcdnt.xyz is served by the Cloudflare Worker "personal-site". Workers Builds
  // runs `npx wrangler deploy` on every push to main using this file.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "personal-site",
  "compatibility_date": "2026-11-23",
  // The dcdnt.xyz/* route is managed in the Cloudflare dashboard. With no "routes"
  // key here, deploys leave it untouched. workers_dev matches the dashboard (on).
  "workers_dev": true,
  // worker/index.js runs only for /api/* (the photo page's admin mode); every other path is
  // served straight from the static files, as before.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/tracker", "/pictures"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CLICKS", "class_name": "PictureClicks" }]
  },
  "migrations": [{ "tag": "clicks-v1", "new_sqlite_classes": ["PictureClicks"] }],
  // Where admin mode commits pictures.json. Secrets (ADMIN_PASSWORD, GITHUB_TOKEN) are set in
  // the Cloudflare dashboard, never here.
  "vars": {
    "GITHUB_REPO": "quinzdom/personal-site",
    "GITHUB_BRANCH": "main"
  }
}
